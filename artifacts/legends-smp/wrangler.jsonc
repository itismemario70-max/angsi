{
  "name": "legends",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "secrets": {
    "required": [
      "SESSION_SECRET",
      "LEGENDS_ADMIN_CODE",
      "LEGENDS_OWNER_CODE"
    ]
  },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
